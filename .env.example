# Blooms of Santa Barbara — environment variables. Copy to .env.local for development; set them
# in Vercel for deployments. The site builds and runs without any of them: the inquiry form then
# logs to the server console instead of sending email, and the Instagram section shows the
# built-in photos instead of the live feed.

# Inquiry emails (Gmail SMTP with an app password). EMAIL_TO defaults to EMAIL_USER.
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Velour Web dashboards: page views, Call/Text/Email taps and every inquiry are reported to
# velourweb.com (/admin and the owner's /vendor link). Copy the three values from
# velourweb.com/admin → Blooms of Santa Barbara → Tracking setup. Leave empty to turn reporting off.
VELOUR_TRACK_URL=
VELOUR_SITE_SLUG=
VELOUR_LEAD_SECRET=

# Live Instagram grid ("Follow along" on the home page). Two ways to feed it; the first that is
# configured wins. Without either, the grid shows the site's own photos linking to the profile.
#
# 1. The Fiory / florist platform feed, where the business connects Instagram once and the token
#    is refreshed for it (same setup as chicflowers.com). Vendor slug = business name, hyphenated.
INSTAGRAM_FEED_ORIGIN=
INSTAGRAM_VENDOR_SLUG=blooms-of-santa-barbara
#
# 2. A long-lived Instagram Basic Display / Graph API access token for @bloomsofsantabarbara.
INSTAGRAM_ACCESS_TOKEN=
